<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Conexion" parent="Theme.Material3.DayNight.NoActionBar">
        
        <!-- Colores Primarios de la Marca -->
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryVariant">@color/brand_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Colores Secundarios (Acentos) -->
        <item name="colorSecondary">@color/brand_green_accent</item>
        <item name="colorSecondaryVariant">@color/brand_green_accent</item> 
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
    </style>

    <style name="Theme.Conexion" parent="Base.Theme.Conexion" />
</resources>
